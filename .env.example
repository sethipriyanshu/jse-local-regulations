# Copy to .env and adjust. Every key maps to a field in backend/app/config.py.
ENV=local
DATABASE_URL=mssql+pymssql://sa:LocalDev_Passw0rd!@127.0.0.1:1433/jse_regs
STORAGE_CONNECTION_STRING=file:.data/blobs
ADMIN_PASSCODE=change-me
SESSION_SECRET=dev-only-secret-change-me

# Azure AI Foundry / Azure OpenAI (copy from the MEP-QC .env)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Optional: Teams Workflows webhook for the daily digest and alerts, and the app URL for card links
TEAMS_WEBHOOK_URL=
PUBLIC_BASE_URL=http://localhost:5173
